<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>create new chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h3>Create New Chat</h3>
    <form action="/chats" method="POST">
    <input type="text" placeholder="Who are you?" name="from"> <br><br>
    <textarea name="msg" placeholder="Type Your Message" rows="6" cols="20" class="msg"></textarea><br><br>
    <input type="text" placeholder="Receiver Name" name="to"><br><br>
    <button class="edit-btn">Submit</button>
    </form>
</body>
</html>