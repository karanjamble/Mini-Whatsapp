<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>WhatsApp</h1>
    <form action="/chats/new" method="GET">
        <button class="create-btn">Create New Chat</button>
    </form>
    <%for(let chat of chats){%>
    <div class="chat">
        <p class="sender">From <%= chat.from %></p>
        <div class="msg">
        <p><%=chat.msg %>
            <form method="GET" action="/chats/<%=chat._id%>/edit">
                <button class="edit-btn">Edit</button>
            </form>
        </p>
        </div>
        <p class="receiver">received by <%=chat.to%></p>
        <div class="date">
            <p><%=chat.created_at.toString().split(" ")[4]%></p>
            <p><%=chat.created_at.toString().split(" ").slice(0,4).join("-")%></p>
        </div>
        <form action="/chats/<%=chat.id%>?_method=DELETE" method="POST">
            <button class="del-btn">Delete</button>
        </form>
        
    </div>
    <br><br>
<%}%>
</body>
</html>
